aidl_interface {
    name: "com.motorola.hardware.biometric.fingerprint",
    vendor_available: true,
    srcs: ["com/motorola/hardware/biometric/fingerprint/*.aidl"],
    stability: "vintf",
    owner: "motorola",

    backend: {
        cpp: {
            enabled: true,
        },
        java: {
            sdk_version: "module_current",
        },
        ndk: {
            enabled: true,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },
    ],
}
